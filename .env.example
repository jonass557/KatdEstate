# =============================================================================
# RentFlow Africa — variables d'environnement (API + base de données)
# =============================================================================
#
# MODE D'EMPLOI
#   1. Copiez ce fichier vers « .env » à la racine du dépôt :
#        cp .env.example .env          (macOS / Linux / Git Bash)
#        copy .env.example .env        (Windows CMD)
#   2. Remplacez les deux secrets ci-dessous par des valeurs aléatoires.
#   3. Ne committez JAMAIS le fichier « .env » : il est déjà exclu par .gitignore.
#
# GÉNÉRER DES SECRETS SOLIDES (une commande, deux fois) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# =============================================================================

# --- Environnement -----------------------------------------------------------
# development | test | production
NODE_ENV=development

# --- Serveur API -------------------------------------------------------------
# Port d'écoute de l'API.
PORT=4000
# URL publique de l'API, utilisée pour les liens absolus et les webhooks.
SERVER_URL=http://localhost:4000
# Passer à « true » uniquement derrière un reverse proxy de confiance
# (Nginx, Traefik, Heroku, Render…) : fait confiance à X-Forwarded-*.
TRUST_PROXY=false

# --- Base de données ---------------------------------------------------------
# MongoDB local. En production : chaîne fournie par votre hébergeur MongoDB,
# avec TLS et authentification.
MONGODB_URI=mongodb://127.0.0.1:27017/rentflow_africa
# Délai maximal d'attente de la base au démarrage, en millisecondes.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- Client autorisé (CORS) --------------------------------------------------
# Origine(s) autorisée(s) à appeler l'API. Plusieurs valeurs séparées par des
# virgules. Doit correspondre exactement à l'URL du navigateur (schéma + hôte + port).
# En production : uniquement des URL HTTPS.
CLIENT_URL=http://localhost:5173

# --- Jetons d'authentification ----------------------------------------------
# Les deux secrets DOIVENT être différents et faire au moins 32 caractères.
# Le serveur refuse de démarrer si ces valeurs d'exemple sont utilisées en production.
JWT_ACCESS_SECRET=replace-with-a-long-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-development-secret
JWT_ISSUER=rentflow-api
JWT_AUDIENCE=rentflow-web
# Durée de vie de l'access token (format : 15m, 12h, 30d, 3600s).
ACCESS_TOKEN_TTL=15m
# Durée de vie du refresh token, alignée sur celle du cookie.
REFRESH_TOKEN_TTL=30d

# --- Email delivery -----------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- Cookie de refresh -------------------------------------------------------
COOKIE_NAME=rentflow_refresh
# À laisser vide en local. En production : le domaine parent, ex. « .rentflow.africa ».
COOKIE_DOMAIN=
# true en production (cookie transmis en HTTPS uniquement). Le serveur l'exige.
COOKIE_SECURE=false

# --- Limitation de débit -----------------------------------------------------
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=60000
RATE_LIMIT_SENSITIVE_MAX=30

# --- Journalisation ----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Cloudinary (Stockage images, documents, certificats et sceaux) -----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kadtestate

# --- Google Maps Platform (Cartographie Géographique 3 Niveaux) -------------
# Clé REST serveur optionnelle (strictement privée serveur, jamais exposée au front)
GOOGLE_MAPS_SERVER_API_KEY=
# Clé frontend Vite (avec restrictions HTTP Referrer sur Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=
