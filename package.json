{
  "name": "rentflow-africa",
  "version": "0.1.0",
  "private": true,
  "description": "RentFlow Africa - foundation workspace for a multi-tenant rental management SaaS.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build --workspace @rentflow/shared",
    "dev": "concurrently -n api,web -c blue,green \"npm run api:dev\" \"npm run web:dev\"",
    "prebuild": "npm run build --workspace @rentflow/shared",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build --workspace @rentflow/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build --workspace @rentflow/shared",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "clean": "npm run clean --workspaces --if-present",
    "start": "npm run start --workspace @rentflow/api",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:check": "npm run db:check --workspace @rentflow/api",
    "api:dev": "npm run dev --workspace @rentflow/api",
    "api:dev:pretty": "npm run dev:pretty --workspace @rentflow/api",
    "api:build": "npm run build --workspace @rentflow/api",
    "api:start": "npm run start --workspace @rentflow/api",
    "api:test": "npm run test --workspace @rentflow/api",
    "web:dev": "npm run dev --workspace @rentflow/web",
    "web:build": "npm run build --workspace @rentflow/web",
    "web:preview": "npm run preview --workspace @rentflow/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
