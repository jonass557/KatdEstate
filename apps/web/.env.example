# =============================================================================
# RentFlow Africa — variables d'environnement (interface web / Vite)
# =============================================================================
#
# Vite n'expose au navigateur QUE les variables préfixées par « VITE_ ».
# N'écrivez jamais de secret ici : tout ce qui commence par VITE_ est public,
# inclus en clair dans le bundle JavaScript livré au navigateur.
#
# Ce fichier est optionnel en développement : sans lui, le client utilise
# http://localhost:4000/api/v1, la valeur par défaut de l'API locale.
# =============================================================================

# URL de base de l'API, chemin « /api/v1 » inclus.
VITE_API_URL=http://localhost:4000/api/v1
